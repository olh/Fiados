# Fiados Local Sandbox Environment Configuration
# Strictly synthetic data only — never place production credentials or real PII here.

FIADOS_ENV=sandbox
FIADOS_SYNTHETIC_MODE=true
FIADOS_LOG_LEVEL=INFO

# Local Containerized Storage
FIADOS_DATABASE_URL=postgresql+psycopg://fiados_dev:fiados_sandbox_local@localhost:5432/fiados_sandbox
FIADOS_REDIS_URL=redis://localhost:6379/0

# Webhook & Cryptographic Sandbox Keys (Synthetic Only)
FIADOS_WEBHOOK_HMAC_SECRET=whsec_sandbox_synthetic_000000000000000000000000
FIADOS_SIGNER_KEY_ID=sandbox-key-ed25519-01

# Default Risk Policy Parameters
FIADOS_DEFAULT_MAX_TICKET_CENTS=500000
FIADOS_DEFAULT_MAX_INSTALLMENTS=12
FIADOS_DEFAULT_MAX_DTI_RATIO=0.30
